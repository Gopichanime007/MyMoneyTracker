{
  "name": "money-tracker-tests",
  "version": "1.0.0",
  "description": "Unit tests for MoneyTracker core logic",
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text --coverageReporters=json-summary",
    "lint": "node scripts/lint.js",
    "build": "node scripts/build.js",
    "validate:development": "npm run lint && npm run test:coverage && npm run build",
    "hooks:install": "node scripts/setup-git-hooks.js",
    "release:gate": "node scripts/release-gate.js",
    "uat:browser": "playwright test -c playwright.config.js",
    "uat:browser:chrome-edge": "playwright test -c playwright.config.js --project=chrome --project=edge",
    "uat:browser:mobile": "playwright test -c playwright.config.js --project=mobile-chrome"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^21.0.0"
  }
}
